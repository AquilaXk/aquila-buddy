DB_URL=jdbc:postgresql://localhost:5432/aquila_buddy
DB_USER=aquila
DB_PASSWORD=aquila
GITHUB_TOKEN=
GITHUB_TOKEN_PERMISSIONS=metadata:read,contents:read,pull-requests:read,issues:read
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_ISSUE_SEARCH_ENABLED=false
GITHUB_ISSUE_SEARCH_QUERY=label:"good first issue"
GITHUB_ISSUE_SEARCH_LIMIT=3
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_USER_CONTEXT_ENABLED=false
DEFAULT_GITHUB_ID=10001
AI_PROVIDER=vertex-ai
GOOGLE_CLOUD_PROJECT_ID=grepp-ai-project
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_AI_EMBEDDING_DIMENSIONS=1536
VERTEX_AI_CREDENTIALS_PATH=./vertex-key.json
GOOGLE_APPLICATION_CREDENTIALS=./vertex-key.json
# OpenAI-compatible provider option.
# AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=local
RECOMMENDATION_SIMILARITY_PROVIDER=score
RECOMMENDATION_SIMILARITY_LIMIT=20
APP_EMBEDDING_BACKFILL_OPERATION_TOKEN=
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_EXPIRATION=1h
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback

# Real provider E2E smoke is opt-in because it calls OAuth-protected APIs,
# GitHub, pgvector, and the configured AI provider.
PROVIDER_E2E_SMOKE_ENABLED=false
PROVIDER_E2E_DRY_RUN=true
BACKEND_BASE_URL=http://localhost:8080
PROVIDER_E2E_AUTH_MODE=oauth-header
PROVIDER_E2E_AUTH_HEADER=
PROVIDER_E2E_REPO_FULL_NAME=
PROVIDER_E2E_ISSUE_NUMBER=
PROVIDER_E2E_BASE_BRANCH=main
PROVIDER_E2E_HEAD_BRANCH=provider-e2e-smoke
PROVIDER_E2E_SEARCH_QUERY=
PROVIDER_E2E_DIFF_CONTENT=
PROVIDER_E2E_BACKFILL_LIMIT=20
EMBEDDING_BACKFILL_OPERATION_TOKEN=

# OCI Always Free A1 Flex Terraform placeholders.
# Prefer infra/terraform/oci/always-free-a1-flex/terraform.env.example for shell export usage.
TF_VAR_tenancy_ocid=ocid1.tenancy.oc1..example
TF_VAR_user_ocid=ocid1.user.oc1..example
TF_VAR_fingerprint=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
TF_VAR_private_key_path=~/.oci/oci_api_key.pem
TF_VAR_region=ap-seoul-1
TF_VAR_compartment_ocid=ocid1.compartment.oc1..example
TF_VAR_availability_domain=example:AP-SEOUL-1-AD-1
TF_VAR_image_operating_system="Canonical Ubuntu"
TF_VAR_ssh_public_key="ssh-ed25519 example-public-key"
TF_VAR_ssh_ingress_cidr=203.0.113.10/32
TF_VAR_http_ingress_cidr=0.0.0.0/0
TF_VAR_https_ingress_cidr=0.0.0.0/0
TF_VAR_name_prefix=aquila-buddy-a1
TF_VAR_hostname_label=aquilabuddy
TF_VAR_vcn_dns_label=aquilabuddyvcn
TF_VAR_subnet_dns_label=public
TF_VAR_vcn_cidr=10.40.0.0/16
TF_VAR_subnet_cidr=10.40.1.0/24
TF_VAR_instance_ocpus=4
TF_VAR_instance_memory_in_gbs=24
TF_VAR_boot_volume_size_in_gbs=50
TF_VAR_data_volume_size_in_gbs=150
TF_VAR_data_volume_vpus_per_gb=0
TF_VAR_data_volume_device=/dev/oracleoci/oraclevdb
TF_VAR_data_volume_mount_path=/var/lib/aquila-data
