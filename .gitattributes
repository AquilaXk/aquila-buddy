# Text source files always use LF on every checkout so Node/shell tests do not break on Windows CRLF.
* text=auto eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.xml text eol=lf
Dockerfile* text eol=lf
gradlew text eol=lf

# Windows batch scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary and vendored assets stay byte-exact.
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.ico -text
*.icns -text
*.jar -text
*.woff -text
*.woff2 -text
