# Copy this file to a private path such as /opt/aquila-buddy/aquila-buddy.env.
# Do not commit the real env file or credential JSON files.

AQUILA_BUDDY_DOMAIN=buddy.aquilaxk.site
AQUILA_BUDDY_IMAGE_PREFIX=ghcr.io/aquilaxk
AQUILA_BUDDY_IMAGE_TAG=replace-with-git-sha
AQUILA_BUDDY_BACKEND_IMAGE=ghcr.io/aquilaxk/aquila-buddy-back:replace-with-git-sha
AQUILA_BUDDY_FRONTEND_IMAGE=ghcr.io/aquilaxk/aquila-buddy-front:replace-with-git-sha
AQUILA_BUDDY_NETWORK=aquila-buddy
AQUILA_BUDDY_FRONTEND_CONTAINER=aquila-buddy-front
AQUILA_BUDDY_BACKEND_CONTAINER=aquila-buddy-back
AQUILA_BUDDY_DB_CONTAINER=aquila-buddy-postgres
AQUILA_BUDDY_DB_VOLUME=aquila-buddy-postgres-data
AQUILA_BUDDY_FRONTEND_PORT=13011
AQUILA_BUDDY_BACKEND_PORT=18091
AQUILA_BUDDY_BIND_ADDRESS=127.0.0.1
AQUILA_BUDDY_NGINX_CONFIG_PATH=/etc/nginx/conf.d/aquila-buddy.conf
AQUILA_BUDDY_SSL_CERTIFICATE=/etc/letsencrypt/live/buddy.aquilaxk.site/fullchain.pem
AQUILA_BUDDY_SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/buddy.aquilaxk.site/privkey.pem
AQUILA_BUDDY_VERTEX_KEY_HOST_PATH=/opt/aquila-buddy/secrets/vertex-key.json

POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=aquila_buddy
POSTGRES_USER=aquila
POSTGRES_PASSWORD=change-this-postgres-password
DB_URL=jdbc:postgresql://aquila-buddy-postgres:5432/aquila_buddy
DB_USER=aquila
DB_PASSWORD=change-this-postgres-password

SPRING_PROFILES_ACTIVE=dev
NEXT_PUBLIC_API_URL=https://buddy.aquilaxk.site
NEXT_PUBLIC_BACKEND_OAUTH_URL=https://buddy.aquilaxk.site/oauth2/authorization/github
OAUTH2_REDIRECT_URI=https://buddy.aquilaxk.site/oauth/callback
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_EXPIRATION=1h
DEFAULT_GITHUB_ID=10001

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_TOKEN_PERMISSIONS=metadata:read,contents:read,pull-requests:read,issues:read
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_USER_CONTEXT_ENABLED=true
GITHUB_ISSUE_SEARCH_ENABLED=true
GITHUB_ISSUE_SEARCH_QUERY=label:"good first issue"
GITHUB_ISSUE_SEARCH_LIMIT=3

AI_PROVIDER=vertex-ai
GOOGLE_CLOUD_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_AI_EMBEDDING_DIMENSIONS=1536
VERTEX_AI_CREDENTIALS_PATH=/run/secrets/vertex-key.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-key.json

AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_REQUEST_TIMEOUT_MILLIS=30000

LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=production

RECOMMENDATION_SIMILARITY_PROVIDER=pgvector
RECOMMENDATION_SIMILARITY_LIMIT=20
APP_EMBEDDING_BACKFILL_OPERATION_TOKEN=
EMBEDDING_BACKFILL_MAX_LIMIT=200
EMBEDDING_BACKFILL_MIN_INTERVAL_SECONDS=0
