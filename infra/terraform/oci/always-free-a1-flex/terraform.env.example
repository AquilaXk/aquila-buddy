# Local-only Terraform environment template.
# Copy to a local shell session or private env file and replace placeholder values.
# Do not commit real OCIDs, fingerprints, private keys, or SSH public keys.

export TF_VAR_tenancy_ocid=ocid1.tenancy.oc1..example
export TF_VAR_user_ocid=ocid1.user.oc1..example
export TF_VAR_fingerprint=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
export TF_VAR_private_key_path=~/.oci/oci_api_key.pem
export TF_VAR_region=ap-seoul-1

export TF_VAR_compartment_ocid=ocid1.compartment.oc1..example
export TF_VAR_availability_domain=example:AP-SEOUL-1-AD-1

export TF_VAR_image_operating_system="Canonical Ubuntu"
export TF_VAR_image_operating_system_version=
export TF_VAR_source_image_ocid_override=

export TF_VAR_ssh_public_key="ssh-ed25519 example-public-key"
export TF_VAR_ssh_ingress_cidr=203.0.113.10/32
export TF_VAR_http_ingress_cidr=0.0.0.0/0
export TF_VAR_https_ingress_cidr=0.0.0.0/0

export TF_VAR_name_prefix=aquila-buddy-a1
export TF_VAR_hostname_label=aquilabuddy
export TF_VAR_vcn_dns_label=aquilabuddyvcn
export TF_VAR_subnet_dns_label=public

export TF_VAR_vcn_cidr=10.40.0.0/16
export TF_VAR_subnet_cidr=10.40.1.0/24

export TF_VAR_instance_ocpus=4
export TF_VAR_instance_memory_in_gbs=24
export TF_VAR_boot_volume_size_in_gbs=50

export TF_VAR_data_volume_size_in_gbs=150
export TF_VAR_data_volume_vpus_per_gb=0
export TF_VAR_data_volume_device=/dev/oracleoci/oraclevdb
export TF_VAR_data_volume_mount_path=/var/lib/aquila-data
