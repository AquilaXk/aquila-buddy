{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aquila Buddy",
  "mainBinaryName": "AquilaBuddy",
  "version": "0.1.0",
  "identifier": "site.aquilaxk.buddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aquila Buddy",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com https://github.com; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://buddy.aquilaxk.site http://localhost:8080 http://127.0.0.1:8080; frame-src 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "licenseFile": "../../LICENSE",
    "publisher": "Aquila Buddy",
    "copyright": "Copyright 2026 Aquila Buddy Contributors. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "GitHub 오픈소스 이슈 추천, 코드 맥락 분석 및 PR 초안 작성 워크스페이스",
    "longDescription": "Aquila Buddy is a cross-platform open-source contribution workspace providing issue matching, code context analysis, and pull request drafting across macOS, Windows, and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libdbus-1-3",
          "libxdo3",
          "libssl3"
        ],
        "recommends": [
          "libayatana-appindicator3-1 | libappindicator3-1",
          "xdg-utils"
        ],
        "desktopTemplate": "./linux/aquila-buddy.desktop"
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libxdo.so.3()(64bit)",
          "libssl.so.3()(64bit)"
        ],
        "desktopTemplate": "./linux/aquila-buddy.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
